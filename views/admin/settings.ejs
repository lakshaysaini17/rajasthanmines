<%- include('../partials/header') %>

<% if (success) { %>
  <div class="alert-banner success">
    ✅ <%= success %>
  </div>
<% } %>
<% if (error) { %>
  <div class="alert-banner error">
    ⚠️ <%= error %>
  </div>
<% } %>

<div class="content-panel" style="max-width: 680px;">
  
  <div class="panel-header">
    <div class="panel-title-with-dot">
      <div class="status-dot"></div>
      <span>Portal &amp; Officer Settings</span>
    </div>
  </div>

  <form action="/admin/settings" method="POST" style="padding: 24px;">
    
    <div class="form-group-item" style="margin-bottom: 16px;">
      <label for="name">Officer / Administrator Display Name</label>
      <input type="text" id="name" name="name" class="form-control-input" value="<%= user.name %>" required>
    </div>

    <div class="form-group-item" style="margin-bottom: 16px;">
      <label for="username">Username (Fixed)</label>
      <input type="text" id="username" class="form-control-input" value="<%= user.username %>" readonly style="background: #f8fafc; color: #64748b;">
    </div>

    <div style="font-size: 13px; font-weight: 700; color: #0a2540; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #e2e8f0; padding-bottom: 6px; margin: 24px 0 16px 0;">
      Change Password
    </div>

    <div class="form-group-item" style="margin-bottom: 16px;">
      <label for="newPassword">New Password (leave empty to keep current)</label>
      <input type="password" id="newPassword" name="newPassword" class="form-control-input" placeholder="••••••••">
    </div>

    <div class="form-group-item" style="margin-bottom: 24px;">
      <label for="confirmPassword">Confirm New Password</label>
      <input type="password" id="confirmPassword" name="confirmPassword" class="form-control-input" placeholder="••••••••">
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 10px;">
      <button type="submit" class="btn-primary-blue">
        Save Settings
      </button>
    </div>

  </form>

</div>

<%- include('../partials/footer') %>
